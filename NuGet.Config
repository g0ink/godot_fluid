<?xml version="1.0" encoding="utf-8"?>
<!--
  Godot 4.6.2 Mono 自带与编辑器严格匹配的 C# SDK 包。
  将它们作为项目级离线源，可以避免首次打开项目时因网络或全局缓存版本不同而构建失败。
-->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".nuget-packages" />
  </config>
  <packageSources>
    <clear />
    <add key="GodotEditorOffline" value=".nuget-offline" />
  </packageSources>
</configuration>
